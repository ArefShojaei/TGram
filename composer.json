{
    "name": "arefshojaei/tgram",
    "description": "PHP Telegram Bot",
    "type": "library",
    "version": "1.2.1",
    "license": "MIT",
    "prefer-stable": true,
    "minimum-stability": "stable",
    "keywords": [
        "telegram",
        "telegram-bot",
        "telegram-api",
        "bot",
        "api",
        "webhook"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "TGram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "ArefShojaei",
            "email": "arefshojaei82@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.10"
    }
}
